STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# No ANTHROPIC_API_KEY here on purpose. The chat coach runs on the Claude Agent SDK, which
# authenticates via `claude login` (once, on this host) against a Claude Pro/Max subscription's
# included usage instead of metered API billing. If you set ANTHROPIC_API_KEY anyway, leave it
# out of this file — claudeClient.ts strips it from the subprocess env so it can't silently
# switch you back to pay-per-token billing.
ANTHROPIC_MODEL=claude-sonnet-5
APP_SHARED_SECRET=
PORT=3000
